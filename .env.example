# ─── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string (local or Atlas)
DATABASE_URL=""

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# App base URL
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ─── Optional: Azure AD SSO ───────────────────────────────────────────────────

AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ─── Optional: Redis / Valkey (rate limiting + caching + real-time SSE) ───────
# Format for Aiven: rediss://default:<password>@<host>:<port>
REDIS_URL=""
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW_SECONDS="60"

# ─── Optional: Email notifications (Resend) ──────────────────────────────────

RESEND_API_KEY=""

# ─── Optional: AI goal suggestions (OpenAI) ──────────────────────────────────

OPENAI_API_KEY=""

# ─── Optional: Public URL (OG tags + sitemap) ────────────────────────────────
# Set to your Vercel URL in production, e.g. https://atomquest-portal.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Optional: Cloudinary (profile avatar uploads) ───────────────────────────
# Create an unsigned upload preset at cloudinary.com → Settings → Upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""